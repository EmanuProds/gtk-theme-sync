[Unit]
Description=Sincroniza o accent e o tema GTK do GNOME com Zed, Ghostty e Flatpak
Documentation=file:%h/.local/bin/gtk-theme-sync
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/gtk-theme-sync --monitor
Restart=on-failure
RestartSec=5
# não bloqueia a sessão se o gsettings estiver demorando
TimeoutStartSec=20

[Install]
WantedBy=graphical-session.target